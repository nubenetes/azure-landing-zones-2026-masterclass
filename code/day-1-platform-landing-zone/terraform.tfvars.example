###############################################################################
# Day 1 - Platform Landing Zone: example values
# Copy to terraform.tfvars, replace the placeholders and commit it (it holds
# identifiers only - never secrets). GUIDs below are documentation examples.
###############################################################################

root_parent_management_group_id = "00000000-0000-0000-0000-000000000000" # Tenant Root Group

platform_subscription_ids = {
  management   = "11111111-1111-1111-1111-111111111111"
  connectivity = "22222222-2222-2222-2222-222222222222"
  identity     = "33333333-3333-3333-3333-333333333333"
  security     = "44444444-4444-4444-4444-444444444444" # optional - remove if not used
}

architecture_name = "alz_2026_masterclass"

#------------------------------------------------------------------------------
# Regions & IPAM - 10.0.0.0/8 split into /12 per region, /16 per archetype
#------------------------------------------------------------------------------
organization_supernet = "10.0.0.0/8"

regions = {
  primary = {
    location     = "westeurope"
    short_name   = "weu"
    index        = 0 # 10.0.0.0/12  -> hub 10.0.0.0/16, corp-prod 10.2.0.0/16 ...
    is_primary   = true
    firewall_sku = "Premium"
  }
  secondary = {
    location     = "northeurope"
    short_name   = "neu"
    index        = 1 # 10.16.0.0/12 -> hub 10.16.0.0/16, corp-prod 10.18.0.0/16 ...
    firewall_sku = "Premium"
  }
}

#------------------------------------------------------------------------------
# Topology - 2 regions and < 50 spokes => customer-managed hub-and-spoke.
# Switch to "virtual_wan" at 3+ regions, 50+ spokes or SD-WAN-heavy estates.
#------------------------------------------------------------------------------
connectivity_type = "hub_and_spoke_vnet"

connectivity_features = {
  ddos_protection_plan      = true
  firewall                  = true
  bastion                   = true
  vpn_gateway               = false
  expressroute_gateway      = true
  private_dns_zones         = true
  private_dns_resolver      = true
  dns_security_policy       = true
  private_dns_auto_registry = false
}

#------------------------------------------------------------------------------
# Management
#------------------------------------------------------------------------------
log_analytics_retention_in_days = 90
sentinel_enabled                = true
security_contact_email          = "secops@example.com"

#------------------------------------------------------------------------------
# Governance - first rollout in a brownfield tenant starts in "audit".
# Promote audit -> remediate -> enforce through pull requests (docs/06).
#------------------------------------------------------------------------------
policy_enforcement_phase = "audit"
allowed_locations        = ["westeurope", "northeurope"]

platform_operators_group_object_id = "55555555-5555-5555-5555-555555555555"

enable_telemetry = true

tags = {
  managed_by   = "terraform"
  workload     = "alz-platform"
  cost_center  = "platform-0001"
  generated_by = "claude-opus-5.5"
  tested       = "false"
}
