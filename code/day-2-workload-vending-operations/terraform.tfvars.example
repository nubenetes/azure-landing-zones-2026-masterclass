###############################################################################
# Day 2 - Subscription vending "order form" (example values)
# Workload teams request a landing zone by opening a PR that adds ONE entry
# to workload_landing_zones. CODEOWNERS routes the review to the platform team.
###############################################################################

platform_state = {
  resource_group_name  = "rg-nbn-iac-state-westeurope"
  storage_account_name = "stnbntfstatea1b2c3"
}

management_subscription_id   = "11111111-1111-1111-1111-111111111111"
connectivity_subscription_id = "22222222-2222-2222-2222-222222222222"

# EA example - use the MCA/MPA format for other agreement types.
subscription_billing_scope = "/providers/Microsoft.Billing/billingAccounts/1234567/enrollmentAccounts/7654321"

hub_gateways_present = true
budget_start_date    = "2026-11-01T00:00:00Z"

workload_landing_zones = {
  # Private, hub-connected production workload => corp MG, 10.2.0.0/24
  payments-prod = {
    display_name          = "Payments API - Production"
    archetype             = "corp"
    environment           = "prod"
    region_key            = "primary"
    spoke_index           = 0
    owner_group_object_id = "66666666-6666-6666-6666-666666666666"
    cost_center           = "cc-payments-1001"
    budget_amount         = 4000
    budget_contact_emails = ["payments-leads@example.com", "finops@example.com"]
    github_repository     = "nubenetes/payments-api"
  }

  # Its non-production twin => corp MG, 10.3.0.0/24
  payments-nonprod = {
    display_name          = "Payments API - Non-production"
    archetype             = "corp"
    environment           = "nonprod"
    region_key            = "primary"
    spoke_index           = 0
    owner_group_object_id = "66666666-6666-6666-6666-666666666666"
    cost_center           = "cc-payments-1001"
    budget_amount         = 1200
    budget_contact_emails = ["payments-leads@example.com"]
    github_repository     = "nubenetes/payments-api"
  }

  # Internet-facing AI assistant in the secondary region => online MG, 10.20.1.0/24
  genai-assistant-prod = {
    display_name           = "GenAI Customer Assistant - Production"
    archetype              = "online"
    environment            = "prod"
    region_key             = "secondary"
    spoke_index            = 1
    owner_group_object_id  = "77777777-7777-7777-7777-777777777777"
    cost_center            = "cc-digital-2002"
    budget_amount          = 8000
    budget_contact_emails  = ["ai-platform@example.com"]
    private_dns_zone_links = true # exception path - see dns.tf
  }

  # Adopt an existing subscription as an isolated sandbox => sandbox MG, 10.15.0.0/24
  data-science-sandbox = {
    display_name             = "Data Science Sandbox"
    archetype                = "sandbox"
    environment              = "nonprod"
    region_key               = "primary"
    spoke_index              = 0
    existing_subscription_id = "88888888-8888-8888-8888-888888888888"
    owner_group_object_id    = "99999999-9999-9999-9999-999999999999"
    cost_center              = "cc-research-3003"
    budget_amount            = 500
    budget_contact_emails    = ["research-leads@example.com"]
  }
}

# Governance rollout: audit -> remediate -> enforce (one PR per promotion)
policy_enforcement_phase        = "audit"
allowed_service_endpoints       = []
defender_storage_malware_cap_gb = 5000
