# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
plan.txt
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Day 1 / Day 2 values are committed as *.auto.tfvars (identifiers only - no
# secrets!): every delivery platform loads them, Terraform Enterprise ignores
# terraform.tfvars. Bootstrap stages keep their values local.
code/day-0-*/terraform.tfvars
code/day-0-*/*.auto.tfvars
*.auto.tfvars.json
backend.hcl

# ALZ provider library cache
.alzlib

# Terraform Stacks: commit .terraform.lock.hcl, ignore local caches
code/hcp-terraform-stacks/**/.terraform/

# Editors / OS
.vscode/
.idea/
.DS_Store
